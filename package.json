{
  "name": "webextension-fip",
  "version": "1.8.0",
  "description": "FIP Radio WebExtension for an in-browser radio playback and scrobbling experience.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "update-stations": "node scripts/update-stations.js",
    "prepackage": "npm run build",
    "package": "web-ext build",
    "package:crx": "npm run build && sh scripts/package-crx.sh",
    "postpackage": "git archive --format=zip -o dist/${npm_package_name}-v${npm_package_version}-source.zip HEAD",
    "test": "LAST_FM_KEY=test LAST_FM_SECRET=test PREFERENCES_NAMESPACE=test node --test 'src/**/*.test.js'",
    "lint": "eslint .",
    "posttest": "npm run lint",
    "build": "BUILD_CHANNEL=stable node --env-file-if-exists=.env node_modules/rollup/dist/bin/rollup --config",
    "version": "sed -i '' -e \"s/\\\"version\\\": \\\".*\\\"/\\\"version\\\": \\\"${npm_package_version}\\\"/\" src/manifest.json && git add src/manifest.json",
    "watch": "BUILD_CHANNEL=dev node --env-file-if-exists=.env node_modules/rollup/dist/bin/rollup --config --watch"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/thom4parisot"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/thom4parisot/webextension-fip.git"
  },
  "keywords": [
    "fip",
    "radio",
    "chrome",
    "extension",
    "audio",
    "live",
    "streaming",
    "france"
  ],
  "author": "Thomas Parisot (https://thom4.net)",
  "license": "MIT",
  "readmeFilename": "README.md",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.14.0",
    "rollup": "^4.68.4",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "angular": "^1.8.2",
    "blueimp-md5": "^2.19.0",
    "machina": "^8.2.0",
    "webextension-polyfill": "^0.12.0"
  }
}
