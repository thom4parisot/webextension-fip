{
  "name": "webextension-fip",
  "version": "1.6.7",
  "description": "FIP Radio WebExtension for an in-browser radio playback and scrobbling experience.",
  "main": "index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "update-stations": "node scripts/update-stations.js",
    "prepackage": "npm run build",
    "package": "cd src && ls manifest.json _locales/**/*.json players/background/bundle.js players/background/index.html now-playing/bundle.js now-playing/*.html now-playing/*.css options/bundle.js options/*.html resources/*.png resources/icons/css/*.css resources/icons/font/*.woff2 | zip -9 -@ ../dist/${npm_package_name}-v${npm_package_version}.zip",
    "postpackage": "git archive --format=zip -o dist/${npm_package_name}-v${npm_package_version}-source.zip HEAD",
    "test": "PREFERENCES_NAMESPACE=test node --env-file-if-exists=.env --test 'src/**/*.test.js'",
    "lint": "eslint src",
    "posttest": "npm run lint",
    "build": "NODE_ENV=production BUILD_CHANNEL=stable rollup --config",
    "version": "sed -i '' -e \"s/\\\"version\\\": \\\".*\\\"/\\\"version\\\": \\\"${npm_package_version}\\\"/\" src/manifest.json && git add src/manifest.json",
    "watch": "BUILD_CHANNEL=dev rollup --config --watch"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/thom4parisot"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/thom4parisot/webextension-fip.git"
  },
  "keywords": [
    "fip",
    "radio",
    "chrome",
    "extension",
    "audio",
    "live",
    "streaming",
    "france"
  ],
  "author": "Thomas Parisot (https://thom4.net)",
  "license": "MIT",
  "readmeFilename": "README.md",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.14.0",
    "rollup": "^4.68.4"
  },
  "dependencies": {
    "angular": "^1.8.2",
    "blueimp-md5": "^2.19.0",
    "machina": "^8.2.0",
    "webextension-polyfill": "^0.12.0"
  }
}
